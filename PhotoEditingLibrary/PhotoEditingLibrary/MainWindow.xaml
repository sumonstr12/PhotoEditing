<Window x:Class="PhotoEditingLibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Editing Library"
        Height="600" Width="400"
        Background="GhostWhite"
        WindowStartupLocation="CenterScreen">

    

    <Grid>

       

        <!-- Image Display Area -->
        <Border BorderBrush="AntiqueWhite" BorderThickness="2" CornerRadius="10" Margin="10" Background="#333">
            <Image x:Name="ImageDisplay" Stretch="Uniform"/>
        </Border>

        <!-- Upload & Camera Buttons (Visible by Default) -->
        <StackPanel x:Name="UploadPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
            <Button Content="📷 Camera" Style="{StaticResource ModernButton}" Click="OpenCamera_Click"/>
            <Button Content="📂 Upload" Style="{StaticResource ModernButton}" Click="OpenImage_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Edit Button (Hidden Initially) -->
        <Button x:Name="EditButton" Content="✏ Edit" Width="120" Height="50"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Visibility="Collapsed" Click="Edit_Click"
                Background="#ff9900" Foreground="White" FontSize="16" FontWeight="Bold"
                BorderThickness="0" Cursor="Hand"/>

        <!-- Editing Options Panel (Initially Hidden) -->
        <StackPanel x:Name="EditingPanel" Visibility="Collapsed"
                    Background="#292929" VerticalAlignment="Bottom" Height="200" Opacity="0.95">
            <!-- Editing Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="🎨 Filter" Style="{StaticResource EditButton}" Click="ShowFilterOptions_Click"/>
                <Button Content="💄 Makeup" Style="{StaticResource EditButton}" Click="ApplyMakeup_Click"/>
                <Button Content="🌄 Background" Style="{StaticResource EditButton}" Click="ChangeBackground_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="📝 Text" Style="{StaticResource EditButton}" Click="AddText_Click"/>
                <Button Content="📜 Template" Style="{StaticResource EditButton}" Click="ApplyTemplate_Click"/>
            </StackPanel>

            <!-- Go Back Button -->
            <Button Content="⬅ Go Back" Style="{StaticResource BackButton}" Click="GoBack_Click"/>
        </StackPanel>

        <!-- Filter Options (Initially Hidden) -->
        <StackPanel x:Name="FilterPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10">
            <Button Content="🎨 Grayscale" Style="{StaticResource EditButton}" Click="ApplyGrayscale_Click"/>
            <Button Content="🌅 Sepia" Style="{StaticResource EditButton}" Click="ApplySepia_Click"/>
            <Button Content="🌞 Brightness" Style="{StaticResource EditButton}" Click="AdjustBrightness_Click"/>
            <Button Content="⬅ Back" Style="{StaticResource BackButton}" Click="GoBackToEdit_Click"/>
        </StackPanel>
    </Grid>
</Window>
